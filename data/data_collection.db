import sqlite3
import pandas as pd
import os

# Chemins de tes fichiers
books_path = "/content/drive/MyDrive/Data_collecte/bookscrape_data.csv"
cars_path = "/content/drive/MyDrive/Data_collecte/gaaras_nettoyer.csv"

# Charger les données
df_books = pd.read_csv(books_path)
df_cars = pd.read_csv(cars_path)

print("Colonnes books :", df_books.columns.tolist())
print("Colonnes cars :", df_cars.columns.tolist())
print(f"Nombre de livres : {len(df_books)}")
print(f"Nombre de voitures : {len(df_cars)}")

# Créer la base de données
conn = sqlite3.connect("/content/data_collection.db")

# Insérer les données
df_books.to_sql("books", conn, if_exists="replace", index=False)
df_cars.to_sql("cars", conn, if_exists="replace", index=False)

conn.close()

print("\n✅ Base de données recréée avec succès")



conn = sqlite3.connect("/content/data_collection.db")
print(pd.read_sql("SELECT name FROM sqlite_master WHERE type='table'", conn))
print("Livres :", pd.read_sql("SELECT COUNT(*) as n FROM books", conn).iloc[0,0])
print("Voitures :", pd.read_sql("SELECT COUNT(*) as n FROM cars", conn).iloc[0,0])